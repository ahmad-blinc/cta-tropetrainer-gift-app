<div id="ctaw-root"></div>

{% if request.design_mode %}
  <div
    id="ctaw-embed-notice"
    style="max-width: 460px; margin: 0 auto; padding: 14px 16px; border-radius: 8px; background: #fdf3e3; color: #8a5b00; border: 1px solid #f6e2b8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.5;"
  >
    This block needs the "Code Lookup Widget" app embed turned on — go to
    App embeds in the theme editor and enable it to preview this widget.
    Customers won't see this message; it's only shown while editing.
  </div>
  <script>
    (function () {
      var attempts = 0;
      var timer = setInterval(function () {
        attempts += 1;
        var root = document.getElementById("ctaw-root");
        if (root && root.children.length > 0) {
          var notice = document.getElementById("ctaw-embed-notice");
          if (notice) notice.remove();
          clearInterval(timer);
        } else if (attempts >= 20) {
          clearInterval(timer);
        }
      }, 250);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Code Lookup",
  "target": "section"
}
{% endschema %}
